# =============================================================================
# VoceUP — Frontend — Variáveis de ambiente
# Copie este arquivo para .env.local e preencha com valores reais.
# NUNCA cometer .env.local no controle de versão. NUNCA usar valores reais aqui.
#
# Este projeto é o FRONTEND (UI). Ele NUNCA deve receber a
# DATABASE_URL, o JWT_SECRET, as credenciais SMTP, nem os segredos do Mercado Pago, nem
# qualquer outro segredo de backend — essas variáveis existem somente no
# projeto voceup-backend. Tudo aqui é ou público por natureza
# (NEXT_PUBLIC_*) ou a URL de outro serviço.
# =============================================================================

# --- App ---------------------------------------------------------------------
# Produção: https://www.voceup.com.br
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Backend (voceup-backend) ----------------------------------------------
# URL pública onde o backend está rodando. Este frontend chama toda a lógica
# de negócio (checkout, IA, transcrição, perguntas, conta, admin) ali, e também
# a autenticação (login, logout, recuperação de senha) — ver src/lib/api/* e
# src/lib/auth/*. Este projeto não acessa o banco de dados.
# Produção: https://api.voceup.com.br
NEXT_PUBLIC_API_URL=http://localhost:3001

# --- Dados do vendedor (OBRIGATÓRIOS para vender) -------------------------------
# Exibidos no rodapé, na página de compra e nos Termos/Política de Privacidade
# (Decreto 7.962/2013 e LGPD). Enquanto nome, documento, endereço e e-mail não
# estiverem preenchidos, a página de compra fica bloqueada.
NEXT_PUBLIC_COMPANY_NAME=
# CNPJ (ou CPF, se vender como pessoa física)
NEXT_PUBLIC_COMPANY_DOCUMENT=
NEXT_PUBLIC_COMPANY_ADDRESS=
# E-mail de atendimento (suporte, cancelamento e reembolso)
NEXT_PUBLIC_COMPANY_EMAIL=
# E-mail para pedidos de privacidade/LGPD (se vazio, usa o de atendimento)
NEXT_PUBLIC_COMPANY_PRIVACY_EMAIL=
NEXT_PUBLIC_COMPANY_PHONE=
# Nome do encarregado de dados (DPO) — opcional para pequeno porte
NEXT_PUBLIC_COMPANY_DPO_NAME=

# --- Analytics (somente carregado após consentimento do usuário) -----------------
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=
