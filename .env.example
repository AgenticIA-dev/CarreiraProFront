# =============================================================================
# CarreiraPro — Frontend — Variáveis de ambiente
# Copie este arquivo para .env.local e preencha com valores reais.
# NUNCA cometer .env.local no controle de versão. NUNCA usar valores reais aqui.
#
# Este projeto é o FRONTEND (UI + autenticação). Ele NUNCA deve receber a
# service role key do Supabase, nem os segredos do Mercado Pago, nem
# qualquer outro segredo de backend — essas variáveis existem somente no
# projeto carreirapro-backend. Tudo aqui é ou público por natureza
# (NEXT_PUBLIC_*) ou a URL de outro serviço.
# =============================================================================

# --- App ---------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Backend (carreirapro-backend) ----------------------------------------------
# URL pública onde o backend está rodando. Este frontend chama toda a lógica
# de negócio (checkout, IA, transcrição, perguntas, conta, admin) ali — ver
# src/lib/api/*.
NEXT_PUBLIC_API_URL=http://localhost:3001

# --- Supabase ------------------------------------------------------------------
# URL e chave anônima — usadas aqui SOMENTE para a sessão de autenticação
# (login, logout, troca de senha). Nenhuma leitura/escrita de dados de
# negócio acontece neste projeto; isso é sempre feito pelo backend.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Analytics (somente carregado após consentimento do usuário) -----------------
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=
